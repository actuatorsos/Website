# ══════════════════════════════════════════════════════════════
# Actuators Platform — Environment Variables
# Copy this file: cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ── Database (SurrealDB) ──
SURREAL_URL=127.0.0.1:8000
SURREAL_USER=Actuators
SURREAL_PASS=Actuators123
SURREAL_NS=Actuators
SURREAL_DB=erp

# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# ── Admin Account (created on first startup) ──
ADMIN_USER=admin@actuators.app
ADMIN_PASS=change_me_strong_password

# ── JWT Authentication ──
# IMPORTANT: Generate for production: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_generate_a_random_64_char_secret_here_now
JWT_EXPIRY_HOURS=24

# ── AI Legal Advisor (OpenRouter) ──
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── Logging ──
RUST_LOG=info
